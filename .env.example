# Copiar a .env en la RAIZ del repositorio. No subir .env a Git.
# Para desarrollo local. Usar una base descartable propia de Fase 6.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bodegas_fase6_dev
DB_USER=bodega_api
DB_PASSWORD=
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- TLS y tiempos (opcionales; Fase 8) ---------------------------------
# DB_SSLMODE: prefer | require | verify-ca | verify-full.
#   Sin valor: prefer si DB_HOST es local; require si es remoto.
#   Un host remoto o el usuario del pooler exigen require o superior.
# DB_SSLMODE=
# DB_SSLROOTCERT: ruta al certificado raíz (obligatorio con verify-ca/verify-full).
# DB_SSLROOTCERT=
# DB_CONNECT_TIMEOUT=10
# DB_POOL_TIMEOUT=10

# --- Nube (Render + Supabase Session pooler) -----------------------------
# Los valores reales se cargan en el panel de Render, nunca aquí.
#   DB_HOST=aws-<n>-<region>.pooler.supabase.com
#   DB_PORT=5432            (Session pooler; 6543 no está permitido)
#   DB_NAME=postgres
#   DB_USER=bodega_api.<PROJECT_REF>
#   DB_SSLMODE=require
#   DB_POOL_MIN=1
#   DB_POOL_MAX=2
